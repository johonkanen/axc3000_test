# Quartus build output
dni/
qdb/
db/
incremental_db/
output_files/
*.qdf
uart_bringup.qsf
uart_bringup.qpf
niosv_zephyr.qsf
niosv_zephyr.qpf
niosv_zephyr/hw/niosv_zephyr_sys.qsys
niosv_zephyr/hw/niosv_zephyr_sys/
niosv_zephyr/hw/tmp-clearbox/
niosv_zephyr/hw/*.hex
niosv_zephyr/hw/build_niosv_system.qpf
niosv_zephyr/hw/build_niosv_system.qsf
niosv_zephyr/hw/ip/rpll0/build_rpll0.qpf
niosv_zephyr/hw/ip/rpll0/build_rpll0.qsf
niosv_zephyr/hw_*/
# qsys-generate's top-level pass regenerates every instance itself under an
# auto-incrementing disambiguation suffix (niosv_zephyr_sys_cb_0.ip,
# _cb_1.ip, ...) that keeps climbing across invocations - only the plain,
# unsuffixed .ip is the real committed baseline source.
niosv_zephyr/hw/ip/niosv_zephyr_sys/niosv_zephyr_sys_*_[0-9]*.ip
*.rpt
*.summary
*.pin
*.sof
*.sld
*.qws
serv_req_info.txt

# generated IP HDL - keep the ip/<name>/<name>.ip source, drop the generated tree
ip/*/*/
niosv_zephyr/hw/ip/*/*/

# emif_cal is a qsys SYSTEM (not a flat .ip like the others above), so its
# own per-instance source file is nested one level deeper
# (ip/emif_cal/ip/emif_cal/emif_cal_cal0.ip) - the generic ip/*/*/ rule
# above would also catch and hide that real source file, so carve it
# back out before re-ignoring just its generated tree.
!niosv_zephyr/hw/ip/emif_cal/ip/
!niosv_zephyr/hw/ip/emif_cal/ip/emif_cal/
!niosv_zephyr/hw/ip/emif_cal/ip/emif_cal/emif_cal_cal0.ip
niosv_zephyr/hw/ip/emif_cal/ip/emif_cal/emif_cal_cal0/
niosv_zephyr/hw/ip/emif_cal/ip/emif_cal/emif_cal_cal0_*/
niosv_zephyr/hw/ip/emif_cal/ip/emif_cal/emif_cal_cal0_*.ip

# python
__pycache__/
*.pyc

# nvc's compiled work library (sim/, niosv_zephyr/hw/sim/, ...)
work/

# VUnit's output dir (run.py)
vunit_out/

# niosv_zephyr: west workspace (zephyr + modules + SDK) is a multi-GB
# multi-repo checkout, not ours to version - see niosv_zephyr/README.md
niosv_zephyr/zephyr/
niosv_zephyr/.west/
niosv_zephyr/.venv/
