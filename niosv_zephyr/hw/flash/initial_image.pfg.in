<pfg version="1">
    <settings custom_db_dir="./" mode="ASX4"/>
    <output_files>
        <output_file name="initial_image" directory="@OUT@/" type="JIC">
            <file_options/>
            <secondary_file type="MAP" name="initial_image_jic">
                <file_options/>
            </secondary_file>
            <flash_device_id>Flash_Device_1</flash_device_id>
        </output_file>
    </output_files>
    <bitstreams>
        <bitstream id="Bitstream_1">
            <path>@SOF@</path>
        </bitstream>
        <bitstream id="Bitstream_2">
            <path>@SOF@</path>
        </bitstream>
    </bitstreams>
    <flash_devices>
        <flash_device type="QSPI256" id="Flash_Device_1">
            <partition reserved="1" fixed_s_addr="1" s_addr="0x00000000" e_addr="0x0020FFFF" fixed_e_addr="1" id="BOOT_INFO" size="0"/>
            <partition reserved="0" fixed_s_addr="1" s_addr="0x00210000" e_addr="0x005FFFFF" fixed_e_addr="1" id="FACTORY_IMAGE" size="0"/>
            <partition reserved="1" fixed_s_addr="0" s_addr="auto" e_addr="auto" fixed_e_addr="0" id="SPT0" size="65536"/>
            <partition reserved="1" fixed_s_addr="0" s_addr="auto" e_addr="auto" fixed_e_addr="0" id="SPT1" size="65536"/>
            <partition reserved="1" fixed_s_addr="0" s_addr="auto" e_addr="auto" fixed_e_addr="0" id="CPB0" size="65536"/>
            <partition reserved="1" fixed_s_addr="0" s_addr="auto" e_addr="auto" fixed_e_addr="0" id="CPB1" size="65536"/>
            <partition reserved="0" fixed_s_addr="1" s_addr="0x00800000" e_addr="0x00BFFFFF" fixed_e_addr="1" id="P1" size="0"/>
            <partition reserved="0" fixed_s_addr="1" s_addr="0x00C00000" e_addr="0x00FFFFFF" fixed_e_addr="1" id="P2" size="0"/>
        </flash_device>
        <flash_loader>A3CY100BM16A</flash_loader>
    </flash_devices>
    <assignments>
        <assignment page="0" partition_id="FACTORY_IMAGE">
            <bitstream_id>Bitstream_1</bitstream_id>
        </assignment>
        <assignment page="1" partition_id="P1">
            <bitstream_id>Bitstream_2</bitstream_id>
        </assignment>
    </assignments>
</pfg>
