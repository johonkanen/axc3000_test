config AXC3000_HYPERRAM
	bool "AXC3000 onboard HyperRAM"
	default $(dt_nodelabel_enabled,hyperram)
	help
	  Waits at boot for the HyperRAM's calibration (hyperram_axi holds the
	  bus until then) and puts a k_heap, hyperram_heap, on the part of the
	  'hyperram' devicetree memory region the linker does not use.
	  Needs zephyr_overlays/niosv_g_hyperram.overlay, and
	  CONFIG_SYS_HEAP_AUTO=y (or _BIG_ONLY): the 256 KB on-chip RAM makes
	  Zephyr default to small-only heaps, capped at 256 KB.

config AXC3000_HYPERRAM_CALIBRATION_TIMEOUT_MS
	int "Longest wait for the HyperRAM calibration"
	default 1000
	depends on AXC3000_HYPERRAM

config UART_AXC3000
	bool "AXC3000 UART with FIFOs"
	default y
	depends on SERIAL && DT_HAS_AXC3000_UART_FIFO_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	help
	  The UART with RX/TX FIFOs of niosv_zephyr/hw/uart/uart_axi4lite.vhd
	  (the FTDI serial port, up to 4.8 MBaud).

config FLASH_AXC3000_SDM_QSPI
	bool "AXC3000 QSPI configuration flash through the SDM mailbox"
	default y
	depends on FLASH && DT_HAS_AXC3000_SDM_QSPI_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_EXPLICIT_ERASE
	select FLASH_HAS_PAGE_LAYOUT
	help
	  The board's QSPI flash through the Mailbox Client IP
	  (niosv_zephyr/hw mbox0, 0xC0000): read, write, erase.

config UART_AXC3000_JTAG
	bool "JTAG UART console that does not hang without a host"
	default y
	depends on SERIAL && DT_HAS_AXC3000_JTAG_UART_ENABLED
	select SERIAL_HAS_DRIVER
	help
	  Replaces Zephyr's altr,jtag-uart driver (which waits for FIFO room
	  with interrupts locked and no timeout): drops characters while no
	  host reads the JTAG UART. The board overlay sets uart0's compatible
	  to axc3000,jtag-uart.

config AXC3000_SDM_REBOOT
	bool "Reboot by reconfiguring the FPGA from the running bitstream"
	default y
	depends on FLASH_AXC3000_SDM_QSPI && REBOOT
	help
	  sys_reboot() asks the SDM to reconfigure the device from the
	  bitstream image that is running (RSU), which reloads MCUboot into the
	  on-chip RAM - the application overwrites it there.

config AXC3000_LIBRSU
	bool "Intel's libRSU (Remote System Update) on the QSPI flash"
	depends on FLASH_AXC3000_SDM_QSPI
	select CRC
	help
	  Intel's open-source libRSU (lib/librsu, BSD-2-Clause): program FPGA
	  application images into the RSU flash slots (P1, P2), make one the
	  highest priority, read the RSU status. <librsu.h>; librsu_init(NULL).
	  It uses malloc: give it a heap (COMMON_LIBC_MALLOC_ARENA_SIZE).

config AXC3000_RSU_MGMT
	bool "FPGA bitstream updates over mcumgr (command group 64)"
	depends on AXC3000_LIBRSU && MCUMGR && AXC3000_HYPERRAM
	help
	  Upload an RSU application image (hw/flash/make_flash_images.sh's
	  application.rpd) over SMP into a HyperRAM buffer, program it into an
	  RSU slot with libRSU and make it the highest priority
	  (mcuboot/update_bitstream.py). Needs
	  MCUMGR_TRANSPORT_WORKQUEUE_STACK_SIZE >= 12288 (libRSU's image
	  blocks live on that stack).
