/*
 * MCUboot -> application boot information (RAM-load: which slot was loaded,
 * its version) in the top 256 bytes of the on-chip RAM, which neither
 * touches otherwise: MCUboot writes it before it jumps (BOOT_SHARE_DATA),
 * the application's image management reads it (RETENTION_BOOTLOADER_INFO).
 * MCUboot and the application must both use this overlay.
 */

&sram0 {
	reg = <0x0 0x3ff00>;
};

/ {
	sram@3ff00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x3ff00 0x100>;
		ranges = <0x0 0x3ff00 0x100>;
		zephyr,memory-region = "RetainedMem";
		#address-cells = <1>;
		#size-cells = <1>;

		retainedmem {
			compatible = "zephyr,retained-ram";
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			boot_info0: boot_info@0 {
				compatible = "zephyr,retention";
				reg = <0x0 0x100>;
			};
		};
	};

	chosen {
		zephyr,bootloader-info = &boot_info0;
	};
};
