# niosv_cpu_clock.cmake - include before find_package(Zephyr): describes
# niosv_zephyr/hw's Nios V/g to Zephyr - its clock-frequency (and so the
# system timer rate) NIOSV_CPU_HZ, which must match the hardware build's
# CPU_CLOCK_MHZ (hw/build_all.sh), plus zephyr_overlays/niosv_g_axc3000.overlay
# (the real ISA - no "a" - and the non-blocking JTAG UART console).
#
#   west build ... -- -DNIOSV_CPU_HZ=100000000
#
# Default 120 MHz, the hardware default.

if(NOT DEFINED NIOSV_CPU_HZ)
  set(NIOSV_CPU_HZ 120000000)
endif()
set(NIOSV_CPU_HZ ${NIOSV_CPU_HZ} CACHE STRING "Nios V/g clock, Hz (hw CPU_CLOCK_MHZ)")

set(_niosv_clock_overlay ${CMAKE_BINARY_DIR}/niosv_cpu_clock.overlay)
file(WRITE ${_niosv_clock_overlay}
     "/* generated by apps/niosv_cpu_clock.cmake */\n&cpu0 {\n\tclock-frequency = <${NIOSV_CPU_HZ}>;\n};\n")
list(APPEND EXTRA_DTC_OVERLAY_FILE
     ${CMAKE_CURRENT_LIST_DIR}/../zephyr_overlays/niosv_g_axc3000.overlay
     ${_niosv_clock_overlay})
# the console driver that overlay selects lives in the axc3000 module
if(NOT "${CMAKE_CURRENT_LIST_DIR}/../zephyr_module" IN_LIST EXTRA_ZEPHYR_MODULES)
  list(APPEND EXTRA_ZEPHYR_MODULES ${CMAKE_CURRENT_LIST_DIR}/../zephyr_module)
endif()
message(STATUS "Nios V/g clock: ${NIOSV_CPU_HZ} Hz")
