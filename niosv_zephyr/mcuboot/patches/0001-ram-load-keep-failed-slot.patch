diff --git a/boot/bootutil/src/loader.c b/boot/bootutil/src/loader.c
index 6edb298e..bda5ba25 100644
--- a/boot/bootutil/src/loader.c
+++ b/boot/bootutil/src/loader.c
@@ -649,12 +649,12 @@ check_validity:
         BOOT_LOG_ERR("Image in the %s slot is not valid!",
                      (slot == BOOT_SLOT_PRIMARY) ? "primary" : "secondary");
 #endif
-        if ((slot != BOOT_SLOT_PRIMARY) || ARE_SLOTS_EQUIVALENT()) {
-            boot_scramble_slot(fap, slot);
-            /* Image is invalid, erase it to prevent further unnecessary
-             * attempts to validate and boot it.
-             */
-        }
+        /* AXC3000: keep it - in RAM-load mode the check runs on the copy
+         * in RAM, and a bad copy must not destroy a good image in flash
+         * (niosv_zephyr/mcuboot/patches/0001-ram-load-keep-failed-slot.patch)
+         */
+        BOOT_LOG_WRN("Image in the %s slot kept in flash",
+                     (slot == BOOT_SLOT_PRIMARY) ? "primary" : "secondary");
         fih_rc = FIH_NO_BOOTABLE_IMAGE;
         goto out;
     }
@@ -2309,8 +2309,13 @@ boot_load_and_validate_images(struct boot_loader_state *state)
              */
             rc = boot_load_image_to_sram(state);
             if (rc != 0 ) {
-                /* Image cannot be ramloaded. */
-                boot_remove_image_from_flash(state, active_slot);
+                /* Image cannot be ramloaded. AXC3000: a failed load (e.g. a
+                 * flash read error) must not destroy the image - skip the
+                 * slot, keep it in flash
+                 * (niosv_zephyr/mcuboot/patches/0001-ram-load-keep-failed-slot.patch).
+                 */
+                BOOT_LOG_WRN("Image %d slot %d not loaded, kept in flash",
+                             BOOT_CURR_IMG(state), active_slot);
                 state->slot_usage[BOOT_CURR_IMG(state)].slot_available[active_slot] = false;
                 state->slot_usage[BOOT_CURR_IMG(state)].active_slot = BOOT_SLOT_NONE;
                 continue;
diff --git a/boot/zephyr/main.c b/boot/zephyr/main.c
index 53cb3c8c..10b36eba 100644
--- a/boot/zephyr/main.c
+++ b/boot/zephyr/main.c
@@ -419,6 +419,16 @@ static void do_boot(struct boot_rsp *rsp)
 
     /* Lock interrupts and dive into the entry point */
     irq_lock();
+#if defined(CONFIG_CACHE_MANAGEMENT) && defined(CONFIG_DCACHE)
+    /* AXC3000: the image was copied (RAM load) through a write-back data
+     * cache - into memory with it before the instructions are fetched
+     * (niosv_zephyr/mcuboot/patches/0001-ram-load-keep-failed-slot.patch)
+     */
+    (void)sys_cache_data_flush_all();
+#endif
+#if defined(CONFIG_CACHE_MANAGEMENT) && defined(CONFIG_ICACHE)
+    (void)sys_cache_instr_invd_all();
+#endif
     ((void (*)(void))start)();
 }
 #endif
